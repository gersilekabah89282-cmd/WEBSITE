# =============================================================================
# SAN STORY AI STUDIO — Environment Variables
# =============================================================================
# ចម្លង​ឯកសារ​នេះ​ទៅជា .env រួច​បំពេញ​តម្លៃ​ពិតប្រាកដ។
# Copy this file to .env and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
WEB_PORT=3000
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
LOG_LEVEL="debug"

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://san:san_password@localhost:5432/san_story?schema=public"
DIRECT_URL="postgresql://san:san_password@localhost:5432/san_story?schema=public"
SHADOW_DATABASE_URL="postgresql://san:san_password@localhost:5432/san_story_shadow?schema=public"

# -----------------------------------------------------------------------------
# Redis (Cache + Queue)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_TLS=false

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET="change-me-to-a-very-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
REFRESH_TOKEN_COOKIE_NAME="san_story_refresh"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/v1/auth/github/callback"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="SAN STORY AI STUDIO <noreply@san-story.ai>"

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
# OpenAI (GPT-4o, Whisper)
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_WHISPER_MODEL="whisper-large-v3"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-1.5-pro"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-3-5-sonnet-20241022"

# DeepL (optional, for high-quality translation)
DEEPL_API_KEY=""

# -----------------------------------------------------------------------------
# TTS / STT Providers
# -----------------------------------------------------------------------------
# Azure Cognitive Services (Speech)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="southeastasia"

# Google Cloud TTS
GOOGLE_TTS_KEY_FILE=""

# ElevenLabs (premium neural voices)
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_VOICE="21m00Tcm4TlvDq8ikWAM"

# -----------------------------------------------------------------------------
# Object Storage (Supabase / S3)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="san-story-media"

# Or use AWS S3 directly
S3_ENDPOINT=""
S3_REGION="ap-southeast-1"
S3_BUCKET="san-story-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Billing (Stripe)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""

# -----------------------------------------------------------------------------
# Webhooks (Outbound)
# -----------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=""
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BACKOFF_MS=1000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_IP_PER_MIN=100
RATE_LIMIT_PER_USER_PER_MIN=1000
RATE_LIMIT_PER_API_KEY_PER_MIN=60

# -----------------------------------------------------------------------------
# File Upload Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=2147483648   # 2 GB
CHUNK_SIZE_BYTES=8388608            # 8 MB
UPLOAD_TIMEOUT_SEC=3600             # 1 hour

# -----------------------------------------------------------------------------
# FFmpeg
# -----------------------------------------------------------------------------
FFMPEG_PATH="/usr/bin/ffmpeg"
FFPROBE_PATH="/usr/bin/ffprobe"
FFMPEG_THREADS=4
FFMPEG_PRESET="medium"
FFMPEG_CRF=23

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE=0.1

OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="san-story-api"

# -----------------------------------------------------------------------------
# BullMQ Dashboard
# -----------------------------------------------------------------------------
BULLMQ_DASHBOARD_PATH="/admin/queues"
BULLMQ_DASHBOARD_USERNAME="admin"
BULLMQ_DASHBOARD_PASSWORD="change-me"

# -----------------------------------------------------------------------------
# Frontend (Vite - exposed to client, prefix with VITE_)
# -----------------------------------------------------------------------------
VITE_API_URL="http://localhost:4000/api/v1"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY=""
VITE_APP_NAME="SAN STORY AI STUDIO"
VITE_APP_VERSION="1.0.0"
VITE_GA_MEASUREMENT_ID=""
VITE_SENTRY_DSN=""

# -----------------------------------------------------------------------------
# Legacy (DevFolio Pro - kept for backward compatibility)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
VITE_SITE_URL="http://localhost:3000"
VITE_CONTACT_EMAIL="contact@san-story.ai"
